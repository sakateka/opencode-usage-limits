{
  "name": "@sakateka/opencode-usage-limits",
  "version": "1.3.3",
  "description": "OpenCode TUI plugin that shows OpenCode GO, OpenAI/Codex, and ZAI Coding Plan usage limits in the sidebar and prompt footer. Trimmed fork of @mynameistito/opencode-usage-limits.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "openai",
    "opencode-go",
    "zai",
    "quota",
    "sidebar",
    "usage-limits"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema": "./usage-limits.schema.json"
  },
  "files": [
    "dist",
    "examples",
    "usage-limits.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && mv dist/index-*.d.mts dist/index.d.mts",
    "test": "NODE_OPTIONS=--experimental-ffi vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.32",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "^20.0.0",
    "solid-js": "1.9.12",
    "tsdown": "^0.14.0",
    "typescript": "^5.9.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  }
}
